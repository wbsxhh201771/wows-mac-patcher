{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoWs Mac Patcher",
  "version": "0.1.0",
  "identifier": "com.chenruhui.wows-mac-patcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "战舰世界 macOS 补丁工具",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  }
}
